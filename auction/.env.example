# Postgres connection string. On Supabase use the "Transaction pooler" URI (port 6543).
# The Vercel ↔ Supabase/Neon integrations set POSTGRES_URL instead, which also works.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/auction_dev

# Password for /admin. Pick something the room won't guess.
ADMIN_PASSWORD=change-me

# Random secret that signs the admin session cookie (e.g. `openssl rand -hex 32`).
SESSION_SECRET=

# Only for `npm test`: a throwaway database that the tests wipe.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/auction_test
