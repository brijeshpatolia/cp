# Required — get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Poll Everywhere participant page to watch
POLLEV_URL=https://pollev.com/mmsapac

# Screen name used at registration
SCREEN_NAME=AI Claude

# Actually click the chosen answer in the page (get organizer permission first!)
AUTO_CLICK=false

# ms between DOM checks
POLL_INTERVAL=750

# Set false to watch the browser locally while debugging selectors
HEADLESS=true

# If PollEv demands a required email at registration, set true to auto-fill a
# placeholder like aiclaude@example.com. Default: warn and wait for a human.
FILL_EMAIL=false
